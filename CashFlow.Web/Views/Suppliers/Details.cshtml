@model CashFlow.Web.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Supplier Details - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <i class="fas fa-truck text-success me-2"></i>Supplier Details
                </h2>
                <div>
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">
                        <i class="fas fa-edit me-2"></i>Edit
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-muted">Supplier Information</h5>
                            <hr />
                            <dl class="row">
                                <dt class="col-sm-4">Name</dt>
                                <dd class="col-sm-8"><strong>@Model.Name</strong></dd>

                                <dt class="col-sm-4">Contact Person</dt>
                                <dd class="col-sm-8">@(Model.ContactPerson ?? "-")</dd>

                                <dt class="col-sm-4">Phone</dt>
                                <dd class="col-sm-8">@(Model.Phone ?? "-")</dd>

                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@(Model.Email ?? "-")</dd>

                                <dt class="col-sm-4">Address</dt>
                                <dd class="col-sm-8">@(Model.Address ?? "-")</dd>

                                <dt class="col-sm-4">Tax Number</dt>
                                <dd class="col-sm-8">@(Model.TaxNumber ?? "-")</dd>

                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted">Statistics</h5>
                            <hr />
                            <div class="text-center">
                                <h3 class="display-6">@Model.ProductCount</h3>
                                <p class="text-muted">Products Supplied</p>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ProductNames))
                            {
                                <hr />
                                <p class="text-muted small">Products: @Model.ProductNames</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-box text-success me-2"></i>Products
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if (ViewBag.Products == null || !((IEnumerable<CashFlow.Core.Entities.Product>)ViewBag.Products).Any())
                        {
                            <div class="list-group-item text-center text-muted py-3">
                                No products from this supplier
                            </div>
                        }
                        else
                        {
                            @foreach (var product in (IEnumerable<CashFlow.Core.Entities.Product>)ViewBag.Products)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold small">@product.ItemName</div>
                                        <div class="text-muted small">@product.ItemCode</div>
                                    </div>
                                    <span class="badge bg-success">R @product.SellingPrice.ToString("N2")</span>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Index", "Products")?supplierId=@Model.Id" class="btn btn-outline-success btn-sm w-100">
                        <i class="fas fa-search me-2"></i>View All Products
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>