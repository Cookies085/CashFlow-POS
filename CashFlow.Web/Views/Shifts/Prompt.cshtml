@{
    ViewData["Title"] = "Shift Required - CashFlow";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0d5c1f 0%, #22c55e 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .prompt-container {
            background: #ffffff;
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

        .icon-container {
            font-size: 4rem;
            color: #f59e0b;
            margin-bottom: 20px;
        }

            .icon-container i {
                background: #fef3c7;
                padding: 25px;
                border-radius: 50%;
            }

        h1 {
            color: #1e293b;
            font-weight: 700;
            font-size: 1.8rem;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #64748b;
            font-size: 1rem;
            margin-bottom: 20px;
        }

        .user-info {
            background: #f8fafc;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 25px;
        }

            .user-info .label {
                color: #64748b;
                font-size: 0.85rem;
            }

            .user-info .value {
                font-weight: 600;
                color: #1e293b;
            }

        .btn-start {
            background: #0d5c1f;
            border: none;
            border-radius: 10px;
            padding: 14px 40px;
            font-weight: 600;
            font-size: 1.1rem;
            color: white;
            transition: all 0.3s ease;
            width: 100%;
            margin-bottom: 10px;
        }

            .btn-start:hover {
                background: #0a4a16;
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(13, 92, 31, 0.3);
                color: white;
            }

            .btn-start:disabled {
                opacity: 0.7;
                cursor: not-allowed;
            }

        .btn-skip {
            background: transparent;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 600;
            color: #64748b;
            transition: all 0.3s ease;
            width: 100%;
        }

            .btn-skip:hover {
                border-color: #94a3b8;
                color: #1e293b;
                background: #f8fafc;
            }

        .btn-logout {
            background: transparent;
            border: none;
            color: #94a3b8;
            font-size: 0.85rem;
            margin-top: 15px;
            padding: 8px 16px;
            transition: all 0.3s ease;
        }

            .btn-logout:hover {
                color: #dc2626;
                text-decoration: underline;
            }

        .alert-warning {
            border-radius: 10px;
            border: none;
            background: #fef3c7;
            color: #92400e;
            padding: 12px 16px;
            font-size: 0.9rem;
        }

        .alert-danger {
            border-radius: 10px;
            border: none;
            background: #fee2e2;
            color: #991b1b;
            padding: 12px 16px;
            font-size: 0.9rem;
            display: none;
        }

        .loading-spinner {
            display: none;
        }

        @@media (max-width: 640px) {
            .prompt-container {
                padding: 30px 20px;
                margin: 10px;
            }

            h1 {
                font-size: 1.5rem;
            }

            .icon-container {
                font-size: 3rem;
            }
        }
    </style>
</head>
<body>
    <div class="prompt-container">
        <div class="icon-container">
            <i class="fas fa-clock"></i>
        </div>

        <h1>Start Your Shift</h1>
        <p class="subtitle">You need to start a shift before using the system</p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert" style="display:block;">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            </div>
        }

        <div class="user-info">
            <div class="row">
                <div class="col-6 text-start">
                    <div class="label">Cashier</div>
                    <div class="value">@(Context.Session.GetString("UserFullName") ?? "Unknown")</div>
                </div>
                <div class="col-6 text-end">
                    <div class="label">Store</div>
                    <div class="value">@(Context.Session.GetString("StoreName") ?? "Main Store")</div>
                </div>
            </div>
        </div>

        <div class="alert alert-warning mb-3" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            A shift must be started to process sales and track your activity.
            <br />
            <small>This ensures accurate reconciliation of your transactions.</small>
        </div>

        <form asp-action="StartShiftFromPrompt" asp-controller="Shifts" method="post" id="startShiftForm">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-start" id="startShiftBtn">
                <i class="fas fa-play me-2"></i>Start Shift
            </button>
        </form>

        <form asp-action="Logout" asp-controller="Auth" method="get">
            <button type="submit" class="btn-skip">
                <i class="fas fa-times me-2"></i>I'll Start Later
            </button>
        </form>

        <div class="mt-2">
            <a href="@Url.Action("Logout", "Auth")" class="btn-logout">
                <i class="fas fa-sign-out-alt me-1"></i>Sign Out
            </a>
        </div>

        <div class="loading-spinner mt-3" id="loadingSpinner">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted small mt-2">Starting shift...</p>
        </div>
    </div>

    <script>
        document.getElementById('startShiftForm').addEventListener('submit', function() {
            var btn = document.getElementById('startShiftBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Starting...';
            document.getElementById('loadingSpinner').style.display = 'block';
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>