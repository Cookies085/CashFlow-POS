@model CashFlow.Web.ViewModels.EndShiftViewModel

@{
    ViewData["Title"] = "End Shift - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="fas fa-stop-circle text-warning me-2"></i>End Shift
            </h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <!-- Shift Summary -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-clock text-warning me-2"></i>Shift Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl>
                                <dt>Cashier</dt>
                                <dd>@Model.Shift?.CashierName</dd>
                                <dt>Started</dt>
                                <dd>@Model.Shift?.StartTime.ToString("dd MMM yyyy HH:mm")</dd>
                                <dt>Opening Balance</dt>
                                <dd>R @Model.Shift?.OpeningBalance.ToString("N2")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl>
                                <dt>Total Orders</dt>
                                <dd>@Model.TotalOrders</dd>
                                <dt>Total Sales</dt>
                                <dd class="text-success fw-bold">R @Model.TotalSales.ToString("N2")</dd>
                                <dt>Cash Sales</dt>
                                <dd>R @Model.TotalCashSales.ToString("N2")</dd>
                            </dl>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Payment Method</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Cash</td>
                                        <td class="text-end">R @Model.TotalCashSales.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Card</td>
                                        <td class="text-end">R @Model.TotalCardSales.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Mobile</td>
                                        <td class="text-end">R @Model.TotalMobileSales.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td>Credit</td>
                                        <td class="text-end">R @Model.TotalCreditSales.ToString("N2")</td>
                                    </tr>
                                    <tr class="table-success">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end fw-bold">R @Model.TotalSales.ToString("N2")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Closing Form -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-calculator text-warning me-2"></i>Close Shift
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="End" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ShiftId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ClosingBalance" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">R</span>
                                        <input asp-for="ClosingBalance" class="form-control" type="number" step="0.01" />
                                    </div>
                                    <span asp-validation-for="ClosingBalance" class="text-danger small"></span>
                                    <div class="text-muted small mt-1">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Enter the actual cash count in the till.
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Notes" class="form-label fw-semibold"></label>
                                    <textarea asp-for="Notes" class="form-control" rows="3"
                                              placeholder="Any notes about the end of shift"></textarea>
                                    <span asp-validation-for="Notes" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Expected Cash:</strong> R @((Model.Shift?.OpeningBalance ?? 0) + Model.TotalCashSales).ToString("N2")
                            <br />
                            <small>Opening balance + Cash sales during shift</small>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-stop me-2"></i>Close Shift
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle text-warning me-2"></i>Tips
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Count all cash in the till
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Include coins and notes
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Compare with expected amount
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Record any discrepancies
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-2"></i>
                            Add notes for manager review
                        </li>
                    </ul>
                    <hr />
                    <div class="alert alert-warning small mb-0">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        Once closed, a shift cannot be reopened.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>