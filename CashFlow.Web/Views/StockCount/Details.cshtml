@model List<CashFlow.Web.ViewModels.StockCountItemViewModel>

@{
    ViewData["Title"] = "Stock Count Details - CashFlow";
    var stockCount = ViewBag.StockCount as CashFlow.Core.Entities.StockCount;
    var summary = ViewBag.Summary as CashFlow.Web.ViewModels.StockCountSummaryViewModel;
}

<style>
    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .status-badge.in-progress {
            background: #fef3c7;
            color: #d97706;
        }

        .status-badge.completed {
            background: #dbeafe;
            color: #2563eb;
        }

        .status-badge.verified {
            background: #dcfce7;
            color: #16a34a;
        }
</style>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2>
                        <i class="fas fa-clipboard-list text-success me-2"></i>Stock Count Details
                    </h2>
                    <p class="text-muted mb-0">
                        <strong>@stockCount?.CountNumber</strong> |
                        Created: @stockCount?.CreatedAt.ToString("dd MMM yyyy HH:mm") |
                        Status: <span class="status-badge @(stockCount?.Status?.ToLower().Replace(" ", "-") ?? "in-progress")">@stockCount?.Status</span>
                    </p>
                    @if (stockCount?.Status == "Verified")
                    {
                        <p class="text-muted mb-0 small">
                            Verified by: @stockCount?.VerifiedByUser?.FullName on @stockCount?.VerifiedAt?.ToString("dd MMM yyyy HH:mm")
                        </p>
                    }
                </div>
                <div>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total Items</p>
                    <h3 class="mb-0">@summary?.TotalItems</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm @(summary?.ItemsWithDiscrepancy > 0 ? "border-danger" : "border-success")">
                <div class="card-body">
                    <p class="text-muted small mb-1">Discrepancies</p>
                    <h3 class="mb-0 @(summary?.ItemsWithDiscrepancy > 0 ? "text-danger" : "text-success")">
                        @summary?.ItemsWithDiscrepancy
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted small mb-1">Over / Short</p>
                    <h3 class="mb-0">
                        <span class="text-danger">+@summary?.TotalOver</span>
                        <span class="text-muted">/</span>
                        <span class="text-success">-@summary?.TotalShort</span>
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted small mb-1">Counted</p>
                    <h3 class="mb-0">@summary?.PercentageComplete.ToString("N0")%</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Items Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-list text-success me-2"></i>Items
                    </h5>
                    <span class="text-muted small">@Model.Count(i => i.ActualStock > 0) of @Model.Count counted</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th class="text-center">System</th>
                                    <th class="text-center">Actual</th>
                                    <th class="text-center">Diff</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var diff = item.Difference;
                                    var isCounted = item.ActualStock > 0;
                                    var rowClass = isCounted && diff != 0 ? "table-danger" :
                                    isCounted && diff == 0 ? "table-success" : "";
                                    <tr class="@rowClass">
                                        <td>
                                            <span class="fw-bold small">@item.ItemCode</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold small">@item.ItemName</div>
                                            @if (!string.IsNullOrEmpty(item.Size))
                                            {
                                                <span class="text-muted small">Size: @item.Size</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@(item.Category ?? "-")</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="fw-bold">@item.SystemStock</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="fw-bold @(isCounted ? "text-dark" : "text-muted")">
                                                @(isCounted? item.ActualStock.ToString() : "-")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (isCounted && diff != 0)
                                            {
                                                <span class="fw-bold @(diff > 0 ? "text-danger" : "text-success")">
                                                    @(diff > 0 ? $" +{diff}" : $" {diff}")
                                                </span>
                                            }
                                            else if (isCounted && diff == 0)
                                            {
                                                <span class="text-muted"><i class="fas fa-check-circle text-success"></i></span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="small text-muted">@(item.Notes ?? "-")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notes -->
    @if (!string.IsNullOrEmpty(stockCount?.Notes))
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="mb-1">Notes</h6>
                        <p class="text-muted mb-0">@stockCount?.Notes</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>