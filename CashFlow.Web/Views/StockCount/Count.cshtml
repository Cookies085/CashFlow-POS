@model List<CashFlow.Web.ViewModels.StockCountItemViewModel>

@{
    ViewData["Title"] = "Stock Count - CashFlow";
    var stockCount = ViewBag.StockCount as CashFlow.Core.Entities.StockCount;
    var summary = ViewBag.Summary as CashFlow.Web.ViewModels.StockCountSummaryViewModel;
}

<style>
    .count-item {
        transition: all 0.2s ease;
    }

        .count-item:hover {
            background: #f8fafc;
        }

        .count-item .stock-input {
            width: 80px;
            text-align: center;
            border: 2px solid #e2e8f0;
            border-radius: 6px;
            padding: 4px 8px;
            transition: all 0.3s ease;
        }

            .count-item .stock-input:focus {
                border-color: #22c55e;
                box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
                outline: none;
            }

            .count-item .stock-input.different {
                border-color: #dc2626;
                background: #fee2e2;
            }

            .count-item .stock-input.matched {
                border-color: #22c55e;
                background: #dcfce7;
            }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .status-badge.in-progress {
            background: #fef3c7;
            color: #d97706;
        }

        .status-badge.completed {
            background: #dbeafe;
            color: #2563eb;
        }

        .status-badge.verified {
            background: #dcfce7;
            color: #16a34a;
        }

    .summary-card {
        border-left: 4px solid #22c55e;
    }

        .summary-card.danger {
            border-left-color: #dc2626;
        }

        .summary-card.warning {
            border-left-color: #f59e0b;
        }

    .progress-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        background: #f1f5f9;
        border: 4px solid #e2e8f0;
    }

        .progress-circle.complete {
            border-color: #22c55e;
            color: #22c55e;
        }

        .progress-circle.partial {
            border-color: #f59e0b;
            color: #f59e0b;
        }
</style>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2>
                        <i class="fas fa-clipboard-list text-success me-2"></i>Stock Count
                    </h2>
                    <p class="text-muted mb-0">
                        <strong>@stockCount?.CountNumber</strong> | Started: @stockCount?.CreatedAt.ToString("dd MMM yyyy HH:mm")
                        | Status: <span class="status-badge @(stockCount?.Status?.ToLower().Replace(" ", "-") ?? "in-progress")">@stockCount?.Status</span>
                    </p>
                </div>
                <div>
                    @if (stockCount?.Status == "In Progress")
                    {
                        <form asp-action="Complete" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@stockCount?.Id" />
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-check me-2"></i>Complete Count
                            </button>
                        </form>
                    }
                    @if (stockCount?.Status == "Completed")
                    {
                        <form asp-action="Verify" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@stockCount?.Id" />
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check-double me-2"></i>Verify Count
                            </button>
                        </form>
                    }
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm summary-card">
                <div class="card-body">
                    <p class="text-muted small mb-1">Progress</p>
                    <h3 class="mb-0">@summary?.PercentageComplete.ToString("N0")%</h3>
                    <small class="text-muted">@summary?.TotalCounted of @summary?.TotalItems counted</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm summary-card @(summary?.ItemsWithDiscrepancy > 0 ? "danger" : "")">
                <div class="card-body">
                    <p class="text-muted small mb-1">Discrepancies</p>
                    <h3 class="mb-0 @(summary?.ItemsWithDiscrepancy > 0 ? "text-danger" : "text-success")">
                        @summary?.ItemsWithDiscrepancy
                    </h3>
                    <small class="text-muted">items with differences</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm summary-card warning">
                <div class="card-body">
                    <p class="text-muted small mb-1">Over/Short</p>
                    <h3 class="mb-0">
                        <span class="text-danger">+@summary?.TotalOver</span>
                        <span class="text-muted">/</span>
                        <span class="text-success">-@summary?.TotalShort</span>
                    </h3>
                    <small class="text-muted">system vs actual</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm summary-card">
                <div class="card-body text-center">
                    <div class="progress-circle @(summary?.PercentageComplete >= 100 ? "complete" : summary?.PercentageComplete > 0 ? "partial" : "")">
                        @summary?.PercentageComplete.ToString("N0")%
                    </div>
                    <small class="text-muted">completion</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Count Items -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-list text-success me-2"></i>Count Items
                    </h5>
                    <span class="text-muted small">@Model.Count(i => i.ActualStock > 0) of @Model.Count counted</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th class="text-center">System</th>
                                    <th class="text-center">Actual</th>
                                    <th class="text-center">Diff</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var diff = item.ActualStock - item.SystemStock;
                                    var hasDiff = diff != 0;
                                    var isCounted = item.ActualStock > 0;
                                    <tr class="count-item" data-item-id="@item.Id">
                                        <td>
                                            <span class="fw-bold small">@item.ItemCode</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold small">@item.ItemName</div>
                                            @if (!string.IsNullOrEmpty(item.Size))
                                            {
                                                <span class="text-muted small">Size: @item.Size</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@(item.Category ?? "-")</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="fw-bold">@item.SystemStock</span>
                                        </td>
                                        <td class="text-center">
                                            <input type="number" class="stock-input @(hasDiff && isCounted ? "different" : isCounted ? "matched" : "")"
                                                   value="@(item.ActualStock > 0 ? item.ActualStock : "")"
                                                   min="0" step="1"
                                                   data-item-id="@item.Id"
                                                   data-system-stock="@item.SystemStock"
                                                   onchange="updateItemCount(@item.Id, this.value)" />
                                        </td>
                                        <td class="text-center">
                                            @if (isCounted && hasDiff)
                                            {
                                                <span class="fw-bold @(diff > 0 ? "text-danger" : "text-success")">
                                                    @(diff > 0 ? $" +{diff}" : $" {diff}")
                                                </span>
                                            }
                                            else if (isCounted && !hasDiff)
                                            {
                                                <span class="text-muted"><i class="fas fa-check-circle text-success"></i></span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Notes..."
                                                   value="@item.Notes"
                                                   onchange="updateItemNotes(@item.Id, this.value)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let updateTimeout = null;

    function updateItemCount(itemId, value) {
        var input = document.querySelector(`input[data-item-id="${itemId}"]`);
        var actualStock = parseInt(value) || 0;
        var systemStock = parseInt(input.dataset.systemStock) || 0;
        var diff = actualStock - systemStock;

        // Update diff display
        var row = input.closest('tr');
        var diffCell = row.querySelector('td:nth-child(6)');

        if (actualStock > 0) {
            if (diff !== 0) {
                diffCell.innerHTML = `<span class="fw-bold ${diff > 0 ? 'text-danger' : 'text-success'}">${diff > 0 ? ' +' + diff : ' ' + diff}</span>`;
                input.classList.remove('matched');
                input.classList.add('different');
            } else {
                diffCell.innerHTML = `<span class="text-muted"><i class="fas fa-check-circle text-success"></i></span>`;
                input.classList.remove('different');
                input.classList.add('matched');
            }
        } else {
            diffCell.innerHTML = `<span class="text-muted">-</span>`;
            input.classList.remove('different', 'matched');
        }

        // Debounce save
        clearTimeout(updateTimeout);
        updateTimeout = setTimeout(function() {
            saveItemCount(itemId, actualStock);
        }, 500);
    }

    function saveItemCount(itemId, actualStock) {
        var notesInput = document.querySelector(`input[data-item-id="${itemId}"]`);
        var row = notesInput.closest('tr');
        var notes = row.querySelector('td:last-child input')?.value || '';

        $.ajax({
            url: '@Url.Action("UpdateItem", "StockCount")',
            type: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            data: {
                itemId: itemId,
                actualStock: actualStock,
                notes: notes
            },
            success: function(response) {
                if (response.success) {
                    // Update the row styling
                    var row = document.querySelector(`input[data-item-id="${itemId}"]`)?.closest('tr');
                    if (row) {
                        if (response.difference !== 0) {
                            row.style.background = '#fef2f2';
                        } else {
                            row.style.background = '';
                        }
                    }
                    // Update summary (reload page to refresh stats)
                    setTimeout(function() {
                        location.reload();
                    }, 1000);
                }
            },
            error: function() {
                console.log('Failed to save count');
            }
        });
    }

    function updateItemNotes(itemId, notes) {
        var input = document.querySelector(`input[data-item-id="${itemId}"]`);
        var actualStock = parseInt(input.value) || 0;
        saveItemCount(itemId, actualStock);
    }
</script>