@model CashFlow.Web.ViewModels.StockCountListViewModel

@{
    ViewData["Title"] = "Stock Count - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <i class="fas fa-clipboard-list text-success me-2"></i>Stock Count
                </h2>
                <a href="@Url.Action("Start")" class="btn btn-success">
                    <i class="fas fa-plus me-2"></i>New Stock Count
                </a>
            </div>
            <hr />
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="get" class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Search</label>
                            <input type="text" name="searchTerm" class="form-control"
                                   placeholder="Search by count number..."
                                   value="@ViewBag.SearchTerm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select name="statusFilter" class="form-select">
                                <option value="">All</option>
                                @foreach (var status in ViewBag.Statuses as List<string> ?? new List<string>())
                                {
                                    <option value="@status" selected="@(ViewBag.CurrentStatus == status)">
                                        @status
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="fas fa-filter me-2"></i>Filter
                            </button>
                        </div>
                        <div class="col-md-3 text-end">
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <i class="fas fa-redo me-2"></i>Clear
                            </a>
                            <span class="ms-2 text-muted">Total: @Model.TotalCount</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Counts Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Count Number</th>
                                    <th>Date</th>
                                    <th>Store</th>
                                    <th>Items</th>
                                    <th>Discrepancies</th>
                                    <th>Total Diff</th>
                                    <th>Status</th>
                                    <th>Created By</th>
                                    <th style="width: 120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.StockCounts.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-4 text-muted">
                                            <i class="fas fa-clipboard-list fa-2x d-block mb-2"></i>
                                            No stock counts found.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var count in Model.StockCounts)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-bold">@count.CountNumber</span>
                                            </td>
                                            <td>@count.CountDate.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@count.StoreName</td>
                                            <td>@count.TotalItems</td>
                                            <td>
                                                @if (count.ItemsWithDiscrepancy > 0)
                                                {
                                                    <span class="badge bg-danger">@count.ItemsWithDiscrepancy</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">0</span>
                                                }
                                            </td>
                                            <td class="@(count.TotalDiscrepancy != 0 ? "text-danger" : "text-success")">
                                                @count.TotalDiscrepancy
                                            </td>
                                            <td>
                                                @{
                                                    var badgeClass = count.Status == "Verified" ? "bg-success" :
                                                    count.Status == "Completed" ? "bg-primary" : "bg-warning text-dark";
                                                }
                                                <span class="badge @badgeClass">@count.Status</span>
                                            </td>
                                            <td>@count.CreatedBy</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="@Url.Action("Details", new { id = count.Id })"
                                                       class="btn btn-outline-info" title="View">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (count.Status == "In Progress")
                                                    {
                                                        <a href="@Url.Action("Count", new { id = count.Id })"
                                                           class="btn btn-outline-primary" title="Continue Count">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav aria-label="Stock Count pagination">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, searchTerm = Model.SearchTerm, statusFilter = Model.StatusFilter })">
                                        Previous
                                    </a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, searchTerm = Model.SearchTerm, statusFilter = Model.StatusFilter })">
                                            @i
                                        </a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, searchTerm = Model.SearchTerm, statusFilter = Model.StatusFilter })">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>