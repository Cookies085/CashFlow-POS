@model List<CashFlow.Web.ViewModels.ExpiryAlertViewModel>

@{
    ViewData["Title"] = "Expiry Alerts - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <i class="fas fa-calendar-times text-danger me-2"></i>Expiry Alerts
                </h2>
                <div>
                    <!-- Filter Buttons -->
                    <a href="@Url.Action("ExpiryAlerts", new { filter = "expired" })"
                       class="btn btn-sm @(ViewBag.ActiveFilter == "expired" ? "btn-danger" : "btn-outline-danger") me-2">
                        <i class="fas fa-exclamation-circle me-1"></i>Expired
                        <span class="badge bg-light text-dark ms-1">@ViewBag.TotalExpired</span>
                    </a>
                    <a href="@Url.Action("ExpiryAlerts", new { filter = "expiring" })"
                       class="btn btn-sm @(ViewBag.ActiveFilter == "expiring" ? "btn-warning" : "btn-outline-warning") me-2">
                        <i class="fas fa-clock me-1"></i>Expiring Soon
                        <span class="badge bg-light text-dark ms-1">@ViewBag.TotalExpiring</span>
                    </a>
                    <a href="@Url.Action("ExpiryAlerts")"
                       class="btn btn-sm @(ViewBag.ActiveFilter == null ? "btn-secondary" : "btn-outline-secondary") me-2">
                        All
                        <span class="badge bg-light text-dark ms-1">@(ViewBag.TotalExpired + ViewBag.TotalExpiring)</span>
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">
                        <i class="fas fa-arrow-left me-2"></i>Back to Products
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
            <h4>No expiry alerts</h4>
            <p class="text-muted">All products have sufficient shelf life or no expiry dates recorded.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Batch</th>
                                <th class="text-center">Qty</th>
                                <th class="text-center">Expiry Date</th>
                                <th class="text-center">Days Left</th>
                                <th>Status</th>
                                <th style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var rowClass = item.DaysUntilExpiry < 0 ? "table-danger" :
                                item.DaysUntilExpiry <= 3 ? "table-warning" :
                                item.DaysUntilExpiry <= 7 ? "table-info" : "";
                                <tr class="@rowClass">
                                    <td>
                                        <div class="fw-bold">@item.ItemName</div>
                                        <div class="text-muted small">@item.ItemCode</div>
                                    </td>
                                    <td>@item.BatchNumber</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-center">@item.ExpiryDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">
                                        @if (item.DaysUntilExpiry < 0)
                                        {
                                            <span class="text-danger fw-bold">@item.DaysUntilExpiry days</span>
                                        }
                                        else
                                        {
                                            <span>@item.DaysUntilExpiry days</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.DaysUntilExpiry < 0)
                                        {
                                            <span class="badge bg-danger">Expired</span>
                                        }
                                        else if (item.DaysUntilExpiry <= 3)
                                        {
                                            <span class="badge bg-warning text-dark">Urgent</span>
                                        }
                                        else if (item.DaysUntilExpiry <= 7)
                                        {
                                            <span class="badge bg-info">Warning</span>
                                        }
                                        else if (item.DaysUntilExpiry <= 30)
                                        {
                                            <span class="badge bg-secondary">Notice</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">OK</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", "Products", new { id = item.ProductId })"
                                           class="btn btn-sm btn-outline-primary" title="View Product">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>