@model IEnumerable<CashFlow.Web.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Low Stock Alert - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>Low Stock Alert
                </h2>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Products
                </a>
            </div>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Current Stock</th>
                                    <th>Min Alert</th>
                                    <th>Reorder Point</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4">
                                            <i class="fas fa-check-circle text-success fa-2x d-block mb-2"></i>
                                            <h5>All products have sufficient stock!</h5>
                                            <p class="text-muted">No products are below their minimum stock level.</p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var product in Model)
                                    {
                                        <tr class="@(product.CurrentStock <= 0 ? "table-danger" : "table-warning")">
                                            <td><strong>@product.ItemCode</strong></td>
                                            <td>@product.ItemName</td>
                                            <td>
                                                @if (product.CurrentStock <= 0)
                                                {
                                                    <span class="badge bg-danger">0 - Out of Stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">@product.CurrentStock</span>
                                                }
                                            </td>
                                            <td>@product.MinStockAlert</td>
                                            <td>@product.ReorderPoint</td>
                                            <td>
                                                @if (product.CurrentStock <= 0)
                                                {
                                                    <span class="badge bg-danger">Critical</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Low</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="@Url.Action("Details", new { id = product.Id })"
                                                       class="btn btn-outline-info" title="View">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = product.Id })"
                                                       class="btn btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>