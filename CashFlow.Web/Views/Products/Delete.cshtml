@model CashFlow.Web.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Delete Product - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="fas fa-trash text-danger me-2"></i>Delete Product
            </h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning!</strong> Are you sure you want to delete this product?
                        <br /><small class="text-muted">This action cannot be undone.</small>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Item Code</dt>
                        <dd class="col-sm-9">@Model.ItemCode</dd>

                        <dt class="col-sm-3">Item Name</dt>
                        <dd class="col-sm-9">@Model.ItemName</dd>

                        <dt class="col-sm-3">Category</dt>
                        <dd class="col-sm-9">@(Model.Category ?? "-")</dd>

                        <dt class="col-sm-3">Current Stock</dt>
                        <dd class="col-sm-9">@Model.CurrentStock</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Confirm Delete
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>