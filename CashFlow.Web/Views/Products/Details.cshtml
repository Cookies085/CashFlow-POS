@model CashFlow.Web.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Product Details - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <i class="fas fa-box text-success me-2"></i>Product Details
                </h2>
                <div>
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">
                        <i class="fas fa-edit me-2"></i>Edit
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-muted">Basic Information</h5>
                            <hr />
                            <dl class="row">
                                <dt class="col-sm-4">Item Code</dt>
                                <dd class="col-sm-8"><strong>@Model.ItemCode</strong></dd>

                                <dt class="col-sm-4">Item Name</dt>
                                <dd class="col-sm-8">@Model.ItemName</dd>

                                <dt class="col-sm-4">Category</dt>
                                <dd class="col-sm-8">@(Model.Category ?? "-")</dd>

                                <dt class="col-sm-4">Size</dt>
                                <dd class="col-sm-8">@(Model.Size ?? "-")</dd>

                                <dt class="col-sm-4">Barcode</dt>
                                <dd class="col-sm-8">@(Model.Barcode ?? "-")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted">Pricing & Stock</h5>
                            <hr />
                            <dl class="row">
                                <dt class="col-sm-4">Cost Price</dt>
                                <dd class="col-sm-8">R @Model.CostPrice.ToString("N2")</dd>

                                <dt class="col-sm-4">Selling Price</dt>
                                <dd class="col-sm-8"><strong>R @Model.SellingPrice.ToString("N2")</strong></dd>

                                <dt class="col-sm-4">Pricing Mode</dt>
                                <dd class="col-sm-8">@Model.PricingMode</dd>

                                <dt class="col-sm-4">Markup</dt>
                                <dd class="col-sm-8">@(Model.MarkupPercentage?.ToString("N2") + "%" ?? "-")</dd>

                                <dt class="col-sm-4">Tax Rate</dt>
                                <dd class="col-sm-8">@Model.TaxRate%</dd>
                            </dl>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-muted">Stock Information</h5>
                            <hr />
                            <dl class="row">
                                <dt class="col-sm-4">Current Stock</dt>
                                <dd class="col-sm-8">
                                    @if (Model.CurrentStock <= 0)
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                    else if (Model.CurrentStock <= Model.MinStockAlert)
                                    {
                                        <span class="badge bg-warning text-dark">@Model.CurrentStock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@Model.CurrentStock</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Min Stock Alert</dt>
                                <dd class="col-sm-8">@Model.MinStockAlert</dd>

                                <dt class="col-sm-4">Reorder Point</dt>
                                <dd class="col-sm-8">@Model.ReorderPoint</dd>

                                <dt class="col-sm-4">Unit</dt>
                                <dd class="col-sm-8">@(Model.Unit ?? "Each")</dd>

                                <dt class="col-sm-4">Weight</dt>
                                <dd class="col-sm-8">@(Model.Weight?.ToString("N2") + " kg" ?? "-")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted">Status</h5>
                            <hr />
                            <dl class="row">
                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Supplier</dt>
                                <dd class="col-sm-8">@(Model.SupplierName ?? "Not assigned")</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar text-success me-2"></i>Quick Stats
                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <h3 class="display-6">
                            @Model.CurrentStock
                        </h3>
                        <p class="text-muted">Items in Stock</p>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span>Profit Per Unit:</span>
                        <strong>R @((Model.SellingPrice - Model.CostPrice).ToString("N2"))</strong>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span>Total Value:</span>
                        <strong>R @((Model.SellingPrice * Model.CurrentStock).ToString("N2"))</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>