@model CashFlow.Web.ViewModels.StockMovementListViewModel

@{
    ViewData["Title"] = "Stock Movements - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <i class="fas fa-warehouse text-success me-2"></i>Stock Movements
                </h2>
                <div>
                    <a href="@Url.Action("Receive")" class="btn btn-success">
                        <i class="fas fa-arrow-down me-2"></i>Receive Stock
                    </a>
                    <a href="@Url.Action("Adjust")" class="btn btn-warning">
                        <i class="fas fa-adjust me-2"></i>Adjust Stock
                    </a>
                    <a href="@Url.Action("Transfer")" class="btn btn-info text-white">
                        <i class="fas fa-exchange-alt me-2"></i>Transfer Stock
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="get" class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input type="text" name="searchTerm" class="form-control"
                                   placeholder="Product, reference, batch..."
                                   value="@ViewBag.SearchTerm" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Movement Type</label>
                            <select name="movementType" class="form-select">
                                <option value="">All</option>
                                @foreach (var type in ViewBag.MovementTypes as List<string> ?? new List<string>())
                                {
                                    <option value="@type" selected="@(ViewBag.CurrentMovementType == type)">
                                        @type
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Date From</label>
                            <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Date To</label>
                            <input type="date" name="dateTo" class="form-control" value="@ViewBag.DateTo" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-filter me-2"></i>Filter
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-redo me-2"></i>Clear
                            </a>
                            <span class="ms-2 text-muted">Total: @Model.TotalCount</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Movements Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Type</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Unit Cost</th>
                                    <th>Reference</th>
                                    <th>Date</th>
                                    <th style="width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Movements.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <i class="fas fa-warehouse fa-2x d-block mb-2"></i>
                                            No stock movements found.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var movement in Model.Movements)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold small">@movement.ProductName</div>
                                                <div class="text-muted small">@movement.ProductCode</div>
                                            </td>
                                            <td>
                                                <span class="badge @(movement.IsAddition ? "bg-success" : "bg-danger")">
                                                    @movement.MovementTypeDisplay
                                                </span>
                                            </td>
                                            <td class="text-center @movement.QuantityColor">
                                                <strong>@movement.DisplayQuantity</strong>
                                            </td>
                                            <td class="text-end">
                                                @(movement.UnitCost?.ToString("N2") ?? "-")
                                            </td>
                                            <td>
                                                <span class="small">@movement.Reference</span>
                                                @if (!string.IsNullOrEmpty(movement.BatchNumber))
                                                {
                                                    <div class="text-muted small">Batch: @movement.BatchNumber</div>
                                                }
                                            </td>
                                            <td>@movement.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>
                                                <a href="@Url.Action("Details", new { id = movement.Id })"
                                                   class="btn btn-sm btn-outline-info" title="View">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav aria-label="Stock pagination">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new { page = Model.CurrentPage - 1, searchTerm = Model.SearchTerm, movementType = Model.MovementType, dateFrom = Model.DateFrom, dateTo = Model.DateTo })">
                                        Previous
                                    </a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new { page = i, searchTerm = Model.SearchTerm, movementType = Model.MovementType, dateFrom = Model.DateFrom, dateTo = Model.DateTo })">
                                            @i
                                        </a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new { page = Model.CurrentPage + 1, searchTerm = Model.SearchTerm, movementType = Model.MovementType, dateFrom = Model.DateFrom, dateTo = Model.DateTo })">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>