@using CashFlow.Web.Controllers
@model StockTransferViewModel

@{
    ViewData["Title"] = "Transfer Stock - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="fas fa-exchange-alt text-info me-2"></i>Transfer Stock
            </h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Transfer" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="ProductId" class="form-label fw-semibold"></label>
                            <select asp-for="ProductId" class="form-select" id="productSelect">
                                <option value="">Select Product</option>
                                @foreach (var product in ViewBag.Products as IEnumerable<CashFlow.Core.Entities.Product> ?? new List<CashFlow.Core.Entities.Product>())
                                {
                                    <option value="@product.Id" data-stock="@product.CurrentStock">
                                        @product.ItemCode - @product.ItemName (Stock: @product.CurrentStock)
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                            <div id="currentStockDisplay" class="mt-1 text-muted small"></div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-semibold"></label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                            <div id="stockWarning" class="text-danger small mt-1"></div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ToStoreId" class="form-label fw-semibold"></label>
                            <select asp-for="ToStoreId" class="form-select">
                                <option value="">Select Target Store</option>
                                @foreach (var store in ViewBag.Stores as IEnumerable<CashFlow.Core.Entities.Store> ?? new List<CashFlow.Core.Entities.Store>())
                                {
                                    <option value="@store.Id">@store.Name - @store.Address</option>
                                }
                            </select>
                            <span asp-validation-for="ToStoreId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Reason for transfer"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-info text-white">
                                <i class="fas fa-exchange-alt me-2"></i>Transfer Stock
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle text-info me-2"></i>Stock Transfer
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Stock Transfer</strong> - Move stock between stores
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Source Store</strong> - Your current store (stock will be deducted)
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Target Store</strong> - Store receiving the stock
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>History</strong> - All transfers are logged for audit
                        </li>
                    </ul>
                    <hr />
                    <div class="alert alert-info small mb-0">
                        <i class="fas fa-info-circle me-1"></i>
                        If the product doesn't exist in the target store, it will be created automatically.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const productSelect = document.getElementById('productSelect');
        const stockDisplay = document.getElementById('currentStockDisplay');
        const quantityInput = document.querySelector('input[name="Quantity"]');
        const stockWarning = document.getElementById('stockWarning');

        productSelect.addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const stock = selectedOption.getAttribute('data-stock') || 0;
            stockDisplay.textContent = `Current Stock: ${stock} units`;
            validateQuantity(stock);
        });

        quantityInput.addEventListener('input', function() {
            const selectedOption = productSelect.options[productSelect.selectedIndex];
            const stock = parseInt(selectedOption.getAttribute('data-stock') || 0);
            validateQuantity(stock);
        });

        function validateQuantity(stock) {
            const qty = parseInt(quantityInput.value) || 0;
            if (qty > stock && stock > 0) {
                stockWarning.textContent = `⚠️ Quantity (${qty}) exceeds current stock (${stock})`;
            } else {
                stockWarning.textContent = '';
            }
        }
    });
</script>