@model CashFlow.Web.ViewModels.StockReceiveViewModel

@{
    ViewData["Title"] = "Receive Stock - CashFlow";
}

<style>
    .selected-product-display {
        background: #f0fdf4;
        border: 2px solid #86efac;
        border-radius: 10px;
        padding: 16px;
        margin-top: 10px;
        display: none;
    }

        .selected-product-display .product-info-display {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .selected-product-display .product-detail {
            font-size: 0.9rem;
        }

            .selected-product-display .product-detail .label {
                color: #64748b;
                font-weight: 500;
            }

            .selected-product-display .product-detail .value {
                font-weight: 600;
                color: #1e293b;
            }

    .cost-increase-warning {
        background: #fef3c7;
        border: 2px solid #f59e0b;
        border-radius: 10px;
        padding: 16px;
        margin-top: 10px;
        display: none;
    }

        .cost-increase-warning .warning-icon {
            color: #f59e0b;
            font-size: 1.5rem;
        }

        .cost-increase-warning .warning-text {
            font-weight: 600;
            color: #92400e;
        }
</style>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="fas fa-arrow-down text-success me-2"></i>Receive Stock
            </h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Receive" method="post" id="receiveForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Product Selection Dropdown -->
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="ProductId" class="form-label fw-semibold">Select Product</label>
                            <select asp-for="ProductId" class="form-select" id="productSelect">
                                <option value="">-- Select Product --</option>
                                @foreach (var product in ViewBag.Products as IEnumerable<CashFlow.Core.Entities.Product> ?? new List<CashFlow.Core.Entities.Product>())
                                {
                                    <option value="@product.Id"
                                            data-cost="@product.CostPrice"
                                            data-price="@product.SellingPrice"
                                            data-stock="@product.CurrentStock"
                                            data-barcode="@product.Barcode">
                                        @product.ItemCode - @product.ItemName (Stock: @product.CurrentStock)
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>

                        <!-- Selected Product Display -->
                        <div class="selected-product-display" id="selectedProductDisplay">
                            <div class="product-info-display">
                                <div>
                                    <div class="fw-bold" id="selectedProductName"></div>
                                    <div class="text-muted small" id="selectedProductCode"></div>
                                </div>
                                <div>
                                    <span class="badge bg-success" id="selectedProductStock"></span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-4">
                                    <div class="product-detail">
                                        <span class="label">Cost Price:</span>
                                        <span class="value" id="selectedCostPrice">R 0.00</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="product-detail">
                                        <span class="label">Selling Price:</span>
                                        <span class="value" id="selectedSellingPrice">R 0.00</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="product-detail">
                                        <span class="label">Barcode:</span>
                                        <span class="value" id="selectedBarcode">-</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cost Increase Warning -->
                        <div class="cost-increase-warning" id="costIncreaseWarning">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fas fa-exclamation-triangle warning-icon"></i>
                                <div>
                                    <div class="warning-text">Cost Increase Detected!</div>
                                    <div id="costIncreaseDetails" class="text-muted small"></div>
                                </div>
                            </div>
                            <div class="mt-2">
                                <input type="checkbox" id="notifyPriceUpdate" name="NotifyPriceUpdate" value="true" checked />
                                <label for="notifyPriceUpdate" class="small">Send notification to review selling price</label>
                            </div>
                        </div>

                        <input type="hidden" asp-for="ProductId" id="selectedProductId" />
                    </div>
                </div>

                <!-- Receiving Details -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-boxes text-success me-2"></i>Receiving Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Quantity" class="form-label fw-semibold"></label>
                                <input asp-for="Quantity" class="form-control" type="number" min="1" id="inputQuantity" />
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="UnitCost" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="UnitCost" class="form-control" type="number" step="0.01" id="inputUnitCost" />
                                </div>
                                <span asp-validation-for="UnitCost" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UnitPrice" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                                <div class="text-muted small mt-1">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Leave blank to use product's current selling price
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="SourceType" class="form-label fw-semibold"></label>
                                <select asp-for="SourceType" class="form-select" id="sourceTypeSelect">
                                    <option value="Purchase">Purchase</option>
                                    <option value="Transfer">Transfer</option>
                                    <option value="Return">Return</option>
                                    <option value="Adjustment">Adjustment</option>
                                    <option value="Donation">Donation</option>
                                    <option value="Consignment">Consignment</option>
                                </select>
                                <span asp-validation-for="SourceType" class="text-danger small"></span>
                                <div class="text-muted small mt-1" id="sourceTypeHelp">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <span id="sourceTypeDescription">Stock purchased from supplier.</span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SupplierId" class="form-label fw-semibold"></label>
                                <select asp-for="SupplierId" class="form-select">
                                    <option value="">Select Supplier</option>
                                    @foreach (var supplier in ViewBag.Suppliers as IEnumerable<CashFlow.Core.Entities.Supplier> ?? new List<CashFlow.Core.Entities.Supplier>())
                                    {
                                        <option value="@supplier.Id">@supplier.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ReceiptNumber" class="form-label fw-semibold"></label>
                                <input asp-for="ReceiptNumber" class="form-control" placeholder="Invoice or PO number" />
                                <span asp-validation-for="ReceiptNumber" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Additional Info -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-info-circle text-success me-2"></i>Additional Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpiryDate" class="form-label fw-semibold"></label>
                                <input asp-for="ExpiryDate" class="form-control" type="date" />
                                <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BatchNumber" class="form-label fw-semibold"></label>
                                <input asp-for="BatchNumber" class="form-control" placeholder="Batch/Lot number" />
                                <span asp-validation-for="BatchNumber" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Reference" class="form-label fw-semibold"></label>
                                <input asp-for="Reference" class="form-control" placeholder="PO, Order, or Invoice number" />
                                <span asp-validation-for="Reference" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Notes" class="form-label fw-semibold"></label>
                                <textarea asp-for="Notes" class="form-control" rows="1" placeholder="Optional notes"></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit -->
                <div class="mt-3">
                    <button type="submit" class="btn btn-success" id="submitBtn">
                        <i class="fas fa-save me-2"></i>Receive Stock
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- Sidebar Tips -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-lightbulb text-success me-2"></i>Quick Tips
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Select Product</strong> - Choose from the dropdown
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Source Type</strong> - Select where stock comes from
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Cost Increase</strong> - You'll be notified if cost increased
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Complete Details</strong> - Fill in quantity, cost, and optional fields
                        </li>
                    </ul>
                    <hr />
                    <div class="alert alert-info small mb-0">
                        <i class="fas fa-info-circle me-1"></i>
                        Once received, stock will be added to your inventory.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedProductCost = 0;
    let selectedProductPrice = 0;
    let selectedProductStock = 0;
    let selectedProductId = null;

    $(document).ready(function() {
        // Product selection change
        $('#productSelect').on('change', function() {
            var selected = $(this).find('option:selected');
            var id = selected.val();
            if (!id) {
                clearSelectedProduct();
                return;
            }
            var name = selected.text().split(' - ')[1] || selected.text();
            var code = selected.text().split(' - ')[0] || '';
            var cost = parseFloat(selected.data('cost')) || 0;
            var price = parseFloat(selected.data('price')) || 0;
            var stock = parseInt(selected.data('stock')) || 0;
            var barcode = selected.data('barcode') || '';

            selectProduct(id, name, code, cost, price, stock, barcode);
        });

        // Quantity or UnitCost change triggers recalculations
        $('#inputQuantity, #inputUnitCost').on('input', function() {
            calculateTotals();
            checkCostIncrease();
        });

        // Source type change
        $('#sourceTypeSelect').on('change', function() {
            updateSourceTypeHelp();
        });

        // If a product was pre-selected (validation error), populate display
        var preselectedId = $('#selectedProductId').val();
        if (preselectedId) {
            var option = $('#productSelect option[value="' + preselectedId + '"]');
            if (option.length) {
                $('#productSelect').val(preselectedId).trigger('change');
            }
        }
    });

    function selectProduct(id, name, code, cost, price, stock, barcode) {
        selectedProductId = id;
        selectedProductCost = cost;
        selectedProductPrice = price;
        selectedProductStock = stock;

        // Set hidden field
        $('#selectedProductId').val(id);

        // Show selected product display
        var display = $('#selectedProductDisplay');
        display.show();
        $('#selectedProductName').text(name);
        $('#selectedProductCode').text('Code: ' + code);
        $('#selectedProductStock').text(stock + ' in stock').removeClass().addClass('badge ' + (stock <= 0 ? 'bg-danger' : 'bg-success'));

        // Auto-fill current cost, price, barcode
        $('#selectedCostPrice').text('R ' + cost.toFixed(2));
        $('#selectedSellingPrice').text('R ' + price.toFixed(2));
        $('#selectedBarcode').text(barcode || '-');

        // Auto-fill UnitCost with current cost
        $('#inputUnitCost').val(cost);

        // Auto-fill UnitPrice with current selling price (if empty)
        var unitPriceField = $('#UnitPrice');
        if (!unitPriceField.val() || unitPriceField.val() === '0') {
            unitPriceField.val(price);
        }

        // Check cost increase
        checkCostIncrease();
        calculateTotals();
    }

    function clearSelectedProduct() {
        selectedProductId = null;
        $('#selectedProductId').val('');
        $('#selectedProductDisplay').hide();
        $('#costIncreaseWarning').hide();
        $('#productSelect').val('');
    }

    function calculateTotals() {
        var qty = parseInt($('#inputQuantity').val()) || 0;
        var unitCost = parseFloat($('#inputUnitCost').val()) || 0;
        var total = qty * unitCost;
        // Optionally display the total somewhere if needed, but we removed the cash section.
        // We can just log it or do nothing.
        // For debugging, we could update a hidden element, but not required.
    }

    function updateSourceTypeHelp() {
        var source = $('#sourceTypeSelect').val();
        var desc = '';
        switch(source) {
            case 'Purchase': desc = 'Stock purchased from supplier.'; break;
            case 'Transfer': desc = 'Stock transferred from another store/location.'; break;
            case 'Return': desc = 'Stock returned from customer.'; break;
            case 'Adjustment': desc = 'Stock adjustment (e.g., correction).'; break;
            case 'Donation': desc = 'Stock received as donation.'; break;
            case 'Consignment': desc = 'Stock received on consignment.'; break;
        }
        $('#sourceTypeDescription').text(desc);
    }

    function checkCostIncrease() {
        var currentCost = selectedProductCost;
        var newCost = parseFloat($('#inputUnitCost').val()) || 0;
        if (currentCost > 0 && newCost > 0 && newCost > currentCost) {
            var diff = newCost - currentCost;
            var percent = (diff / currentCost) * 100;
            $('#costIncreaseDetails').html(
                `Previous: R ${currentCost.toFixed(2)} → New: R ${newCost.toFixed(2)} (Increase: R ${diff.toFixed(2)} / ${percent.toFixed(1)}%)`
            );
            $('#costIncreaseWarning').show();
        } else {
            $('#costIncreaseWarning').hide();
        }
    }

    // Form validation
    $('#receiveForm').on('submit', function(e) {
        var productId = $('#selectedProductId').val();
        if (!productId || productId === '') {
            e.preventDefault();
            alert('Please select a product.');
            $('#productSelect').focus();
            return false;
        }
        return true;
    });

    // Initial state
    updateSourceTypeHelp();
</script>