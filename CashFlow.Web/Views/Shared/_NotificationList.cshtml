@model IEnumerable<CashFlow.Core.Entities.Notification>

@if (!Model.Any())
{
    <div class="text-center text-muted py-3">
        <i class="fas fa-bell-slash me-1"></i> No new notifications
    </div>
}
else
{
    <div class="notification-list">
        @foreach (var notification in Model)
        {
            var typeClass = notification.Type switch
            {
                "Danger" => "text-danger",
                "Warning" => "text-warning",
                "Success" => "text-success",
                _ => "text-info"
            };
            <div class="notification-item d-flex align-items-start p-2 border-bottom @(notification.IsRead ? "text-muted" : "")"
                 data-id="@notification.Id">
                <i class="fas fa-circle @typeClass me-2" style="font-size: 0.6rem; margin-top: 6px;"></i>
                <div class="flex-grow-1">
                    <div class="fw-bold small">@notification.Title</div>
                    <div class="small">@notification.Message</div>
                    <small class="text-muted">@notification.CreatedAt.ToString("dd MMM HH:mm")</small>
                </div>
                @if (!notification.IsRead)
                {
                    <button class="btn btn-sm btn-link text-success p-0" onclick="markNotificationRead(@notification.Id)">
                        <i class="fas fa-check"></i>
                    </button>
                }
            </div>
        }
    </div>
}