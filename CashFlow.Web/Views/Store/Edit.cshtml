@model CashFlow.Web.ViewModels.StoreViewModel

@{
    ViewData["Title"] = "Edit Store - CashFlow";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="fas fa-edit text-primary me-2"></i>Edit Store
            </h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action ="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control" placeholder="Store name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="StoreCode" class="form-label fw-semibold"></label>
                                <input asp-for="StoreCode" class="form-control" placeholder="e.g., JHB001" />
                                <span asp-validation-for="StoreCode" class="text-danger small"></span>
                                <div class="text-muted small">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Leave blank to auto-generate
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label fw-semibold"></label>
                                <input asp-for="Phone" class="form-control" placeholder="+27 12 345 6789" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control" placeholder="store@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Street, City, Province"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ThemeColor" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="ThemeColor" class="form-control" type="color" style="padding: 2px; width: 50px;" />
                                    <span class="input-group-text">@Model.ThemeColor</span>
                                </div>
                                <span asp-validation-for="ThemeColor" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ThemeMode" class="form-label fw-semibold"></label>
                                <select asp-for="ThemeMode" class="form-select">
                                    <option value="light">Light</option>
                                    <option value="dark">Dark</option>
                                </select>
                                <span asp-validation-for="ThemeMode" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <input type="hidden" asp-for="Id" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-2"></i>Update Store
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle text-success me-2"></i>Store Tips
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Store Code</strong> - Unique identifier, used for login
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Theme Color</strong> - Primary color for the store's branding
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-2"></i>
                            <strong>Theme Mode</strong> - Light or dark mode for the store
                        </li>
                    </ul>
                    <hr />
                    <div class="alert alert-info small mb-0">
                        <i class="fas fa-info-circle me-1"></i>
                        Stores can be deactivated instead of deleted.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>