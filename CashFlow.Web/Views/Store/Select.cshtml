@model CashFlow.Web.ViewModels.StoreSelectionViewModel

@{
    ViewData["Title"] = "Select Store - CashFlow";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0d5c1f 0%, #22c55e 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .store-container {
            background: #ffffff;
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .logo-container {
            text-align: center;
            margin-bottom: 30px;
        }

            .logo-container h1 {
                font-size: 2rem;
                font-weight: 700;
                color: #0d5c1f;
            }

        .logo-icon {
            font-size: 2.5rem;
            color: #22c55e;
            margin-bottom: 5px;
        }

        .store-card {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 16px;
            transition: all 0.3s ease;
            cursor: pointer;
            background: #f8fafc;
        }

            .store-card:hover {
                border-color: #22c55e;
                box-shadow: 0 8px 25px rgba(34, 197, 94, 0.2);
                transform: translateY(-2px);
            }

            .store-card .store-icon {
                font-size: 1.5rem;
                color: #0d5c1f;
            }

        .form-control {
            border-radius: 10px;
            padding: 12px 16px;
            border: 2px solid #e2e8f0;
        }

            .form-control:focus {
                border-color: #22c55e;
                box-shadow: 0 0 0 0.2rem rgba(34, 197, 94, 0.25);
            }

        .btn-primary {
            background: #0d5c1f;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background: #0a4a16;
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(13, 92, 31, 0.3);
            }

        .text-link {
            color: #0d5c1f;
            text-decoration: none;
            font-weight: 600;
        }

            .text-link:hover {
                color: #0a4a16;
                text-decoration: underline;
            }

        .store-code-input {
            position: relative;
        }

            .store-code-input .input-group-text {
                background: #0d5c1f;
                color: white;
                border: none;
            }

        .store-grid {
            max-height: 300px;
            overflow-y: auto;
        }

            .store-grid::-webkit-scrollbar {
                width: 6px;
            }

            .store-grid::-webkit-scrollbar-thumb {
                background: #22c55e;
                border-radius: 10px;
            }
    </style>
</head>
<body>
    <div class="store-container">
        <div class="logo-container">
            <div class="logo-icon">
                <i class="fas fa-store"></i>
            </div>
            <h1>Select Your Store</h1>
            <p class="text-muted">Choose your store to continue</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Store Code Entry -->
        <form asp-action="Select" method="post" class="mb-4">
            @Html.AntiForgeryToken()

            <div class="store-code-input">
                <label class="form-label fw-semibold">Enter Store Code</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-hashtag"></i>
                    </span>
                    <input asp-for="StoreCode" class="form-control"
                           placeholder="e.g., JHB001, CPT002"
                           autofocus />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
                <span asp-validation-for="StoreCode" class="text-danger small"></span>
            </div>
        </form>

        <div class="text-center text-muted mb-3">
            <small>— OR —</small>
        </div>

        <!-- Store List -->
        @if (Model.Stores.Any())
        {
            <div class="store-grid">
                @foreach (var store in Model.Stores)
                {
                    <form asp-action="Select" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="StoreCode" value="@store.StoreCode" />
                        <button type="submit" class="store-card w-100 text-start border-0 bg-transparent">
                            <div class="d-flex align-items-center">
                                <div class="store-icon me-3">
                                    <i class="fas fa-store-alt"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-0">@store.Name</h6>
                                    <div class="text-muted small">
                                        <i class="fas fa-map-marker-alt me-1"></i>@(store.Address ?? "No address")
                                        <br />
                                        <i class="fas fa-code me-1"></i>Code: @store.StoreCode
                                    </div>
                                </div>
                                <div>
                                    <i class="fas fa-chevron-right text-success"></i>
                                </div>
                            </div>
                        </button>
                    </form>
                }
            </div>

            <div class="mt-3 form-check">
                <input type="checkbox" id="rememberStore" class="form-check-input" />
                <label for="rememberStore" class="form-check-label small">
                    Remember my store for next time
                </label>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-3">
                <i class="fas fa-store-slash fa-2x d-block mb-2"></i>
                <p>No stores available. Please contact your administrator.</p>
            </div>
        }

        <hr />

        <div class="text-center">
            <small class="text-muted">
                Don't have an account?
                <a asp-action="Register" asp-controller="Auth" class="text-link">Register here</a>
            </small>
        </div>
    </div>

    <script>
        // Remember store checkbox
        document.getElementById('rememberStore')?.addEventListener('change', function() {
            // This will be handled on form submit
            // We'll add the value to the form
            document.querySelector('form').addEventListener('submit', function() {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'RememberStore';
                input.value = document.getElementById('rememberStore').checked;
                this.appendChild(input);
            });
        });

        // Enter key on store code input submits the form
        document.querySelector('[asp-for="StoreCode"]')?.addEventListener('keyup', function(e) {
            if (e.key === 'Enter') {
                this.closest('form').submit();
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>