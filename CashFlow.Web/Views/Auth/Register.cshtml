@model CashFlow.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register - CashFlow POS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0d5c1f 0%, #22c55e 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .register-container {
            background: #ffffff;
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .logo-container {
            text-align: center;
            margin-bottom: 25px;
        }

        .logo-container h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #0d5c1f;
        }

        .logo-icon {
            font-size: 2.5rem;
            color: #22c55e;
            margin-bottom: 5px;
        }

        .form-control {
            border-radius: 10px;
            padding: 10px 14px;
            border: 2px solid #e2e8f0;
        }

        .form-control:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 0.2rem rgba(34, 197, 94, 0.25);
        }

        .btn-primary {
            background: #0d5c1f;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: #0a4a16;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(13, 92, 31, 0.3);
        }

        .text-link {
            color: #0d5c1f;
            text-decoration: none;
            font-weight: 600;
        }

        .text-link:hover {
            color: #0a4a16;
            text-decoration: underline;
        }

        .alert-danger {
            border-radius: 10px;
            border: none;
            background: #fee2e2;
            color: #991b1b;
        }

        .form-label {
            font-weight: 600;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="logo-container">
            <div class="logo-icon">
                <i class="fas fa-coins"></i>
            </div>
            <h1>Create Account</h1>
            <p class="text-muted small">Start your CashFlow journey today</p>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="OrganizationName" class="form-label">Organization Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="fas fa-building text-secondary"></i>
                    </span>
                    <input asp-for="OrganizationName" class="form-control" placeholder="Your business name" />
                </div>
                <span asp-validation-for="OrganizationName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Full Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="fas fa-user text-secondary"></i>
                    </span>
                    <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="fas fa-user-tag text-secondary"></i>
                    </span>
                    <input asp-for="Username" class="form-control" placeholder="Choose a username" />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="fas fa-envelope text-secondary"></i>
                    </span>
                    <input asp-for="Email" class="form-control" placeholder="your@email.com" type="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Phone (Optional)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="fas fa-phone text-secondary"></i>
                    </span>
                    <input asp-for="Phone" class="form-control" placeholder="+27 12 345 6789" />
                </div>
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">Address (Optional)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="fas fa-map-pin text-secondary"></i>
                    </span>
                    <input asp-for="Address" class="form-control" placeholder="Your business address" />
                </div>
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="fas fa-lock text-secondary"></i>
                    </span>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Minimum 6 characters" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0">
                        <i class="fas fa-lock text-secondary"></i>
                    </span>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm your password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-user-plus me-2"></i> Create Account
            </button>
        </form>

        <!-- Add this after the registration form -->
        <div class="alert alert-info mt-3">
            <i class="fas fa-info-circle me-2"></i>
            After registration, you'll receive a <strong>Store Code</strong> that you'll use to login.
        </div>

        <div class="text-center mt-4">
            <p class="mb-0 text-muted">
                Already have an account?
                <a asp-action="Login" class="text-link">Sign in</a>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>