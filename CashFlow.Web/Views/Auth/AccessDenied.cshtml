@{
    ViewData["Title"] = "Access Denied - CashFlow";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0d5c1f 0%, #22c55e 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .access-denied-container {
            background: #ffffff;
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

        .lock-icon {
            font-size: 4rem;
            color: #dc2626;
            margin-bottom: 20px;
        }

            .lock-icon i {
                background: #fee2e2;
                padding: 25px;
                border-radius: 50%;
            }

        h1 {
            color: #1e293b;
            font-weight: 700;
            font-size: 1.8rem;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #64748b;
            font-size: 1rem;
            margin-bottom: 20px;
        }

        .error-message {
            background: #f8fafc;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 25px;
            color: #475569;
            font-size: 0.95rem;
        }

        .btn-primary {
            background: #0d5c1f;
            border: none;
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background: #0a4a16;
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(13, 92, 31, 0.3);
            }

        .btn-secondary {
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 600;
        }

        .user-info {
            background: #f1f5f9;
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

            .user-info .label {
                color: #64748b;
            }

            .user-info .value {
                font-weight: 600;
                color: #1e293b;
            }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

            .status-badge.warning {
                background: #fef3c7;
                color: #d97706;
            }

            .status-badge.info {
                background: #dbeafe;
                color: #2563eb;
            }

            .status-badge.danger {
                background: #fee2e2;
                color: #dc2626;
            }

            .status-badge.success {
                background: #dcfce7;
                color: #16a34a;
            }

        @@media (max-width: 640px) {
            .access-denied-container {
                padding: 30px 20px;
                margin: 20px;
            }

            h1 {
                font-size: 1.5rem;
            }

            .lock-icon {
                font-size: 3rem;
            }
        }
    </style>
</head>
<body>
    <div class="access-denied-container">
        <div class="lock-icon">
            <i class="fas fa-lock"></i>
        </div>

        <h1>Access Denied</h1>
        <p class="subtitle">You don't have permission to access this page</p>

        <div class="user-info">
            <div class="row">
                <div class="col-6 text-start">
                    <span class="label">User:</span>
                    <span class="value">@(Context.Session.GetString("UserFullName") ?? "Guest")</span>
                </div>
                <div class="col-6 text-end">
                    <span class="label">Role:</span>
                    <span class="value">
                        @{
                            var role = Context.Session.GetString("UserRole") ?? "Guest";
                            var badgeClass = role switch
                            {
                                "SuperAdmin" => "status-badge danger",
                                "Admin" => "status-badge info",
                                "Manager" => "status-badge warning",
                                "Cashier" => "status-badge success",
                                _ => "status-badge"
                            };
                        }
                        <span class="@badgeClass">@role</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="error-message">
            <i class="fas fa-exclamation-circle text-danger me-2"></i>
            You don't have the required permissions to view this page.
            <br />
            <small class="text-muted">Please contact your administrator if you believe this is an error.</small>
        </div>

        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                <i class="fas fa-home me-2"></i>Go to Dashboard
            </a>
            <a href="javascript:history.back()" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Go Back
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserRole")))
        {
            <div class="mt-3">
                <a href="@Url.Action("Logout", "Auth")" class="text-muted text-decoration-none small">
                    <i class="fas fa-sign-out-alt me-1"></i>Sign out
                </a>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>