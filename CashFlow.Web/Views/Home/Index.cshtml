@model CashFlow.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard - CashFlow";
}

<link href="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.min.css" rel="stylesheet" />

<div class="container-fluid">
    <!-- Welcome Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">
                                <i class="fas fa-home me-2"></i>Welcome back, @ViewBag.UserName!
                            </h4>
                            <p class="mb-0 text-white-50">
                                <i class="fas fa-store me-1"></i>@ViewBag.StoreName
                                <span class="mx-2">|</span>
                                <span id="currentDateTime"></span>
                            </p>
                        </div>
                        <div>
                            <span class="badge bg-white text-success p-2">
                                <i class="fas fa-circle me-1" style="font-size: 0.5rem; color: #22c55e;"></i>
                                Online
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Today's Sales</p>
                            <h4 class="mb-0 text-success">R @Model.TodaySales.ToString("N2")</h4>
                            <small class="text-muted">@Model.TodayOrders orders</small>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="fas fa-credit-card text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Monthly Sales</p>
                            <h4 class="mb-0 text-primary">R @Model.MonthlySales.ToString("N2")</h4>
                            <small class="text-muted">This month</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="fas fa-calendar-alt text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Total Revenue</p>
                            <h4 class="mb-0 text-warning">R @Model.TotalRevenue.ToString("N2")</h4>
                            <small class="text-muted">All time</small>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="fas fa-coin text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Customers</p>
                            <h4 class="mb-0 text-info">@Model.TotalCustomers</h4>
                            <small class="text-muted">@Model.TotalCustomersWithPoints have loyalty points</small>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="fas fa-users text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (Model.HasLowStock || Model.HasOutOfStock)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-warning">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle text-warning fs-2 me-3"></i>
                            <div>
                                <h5 class="mb-0">Stock Alerts</h5>
                                <p class="mb-0 text-muted">
                                    @if (Model.OutOfStockItems > 0)
                                    {
                                        <span class="text-danger fw-bold">@Model.OutOfStockItems</span>
                                        <span>items out of stock</span>
                                        if (Model.LowStockItems > 0)
                                        {
                                            <span> | </span>
                                        }
                                    }
                                    @if (Model.LowStockItems > 0)
                                    {
                                        <span class="text-warning fw-bold">@Model.LowStockItems</span>
                                        <span>items low on stock</span>
                                    }
                                    <a href="@Url.Action("GetLowStock", "Products")" class="btn btn-sm btn-warning ms-3">
                                        <i class="fas fa-eye me-1"></i>View
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Charts -->
    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar text-success me-2"></i>Sales (Last 7 Days)
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="salesChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-pie text-success me-2"></i>Payment Methods
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="paymentChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Products & Recent Sales -->
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-trophy text-success me-2"></i>Top Products
                    </h5>
                    <a href="@Url.Action("Index", "Products")" class="btn btn-sm btn-outline-success">
                        View All
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.TopProducts.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">
                                            No sales data available
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var product in Model.TopProducts)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold small">@product.ItemName</div>
                                                <div class="text-muted small">@product.ItemCode</div>
                                            </td>
                                            <td class="text-center">@product.TotalQuantity</td>
                                            <td class="text-end text-success">R @product.TotalRevenue.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-clock text-success me-2"></i>Recent Sales
                    </h5>
                    <a href="@Url.Action("Index", "Sales")" class="btn btn-sm btn-outline-success">
                        View All
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Invoice</th>
                                    <th>Customer</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RecentSales.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">
                                            No recent sales
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var sale in Model.RecentSales)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-bold small">@sale.InvoiceNumber</span>
                                                <div class="text-muted small">@sale.SaleDate.ToString("dd MMM HH:mm")</div>
                                            </td>
                                            <td>@sale.CustomerName</td>
                                            <td class="text-end text-success">R @sale.TotalAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mt-2">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Products</p>
                            <h5 class="mb-0">@Model.TotalProducts</h5>
                            <small class="text-muted">@Model.OutOfStockItems out of stock</small>
                        </div>
                        <div class="bg-info bg-opacity-10 p-2 rounded">
                            <i class="fas fa-box text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Loyalty Points</p>
                            <h5 class="mb-0">@Model.TotalLoyaltyPoints</h5>
                            <small class="text-muted">@Model.TotalCustomersWithPoints customers</small>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-2 rounded">
                            <i class="fas fa-star text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Payment Methods</p>
                            <h5 class="mb-0">@Model.SalesByPaymentMethod.Count</h5>
                            <small class="text-muted">types accepted</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                            <i class="fas fa-credit-card text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">Average Order</p>
                            <h5 class="mb-0">
                                R @(Model.TotalCustomers > 0 ? (Model.TotalRevenue / Model.TotalCustomers).ToString("N2") : "0.00")
                            </h5>
                            <small class="text-muted">per customer</small>
                        </div>
                        <div class="bg-success bg-opacity-10 p-2 rounded">
                            <i class="fas fa-calculator text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
    // Update time
    function updateDateTime() {
        const now = new Date();
        const options = {
            weekday: 'short',
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            timeZone: 'Africa/Johannesburg'
        };
        document.getElementById('currentDateTime').textContent = now.toLocaleString('en-ZA', options);
    }
    updateDateTime();
    setInterval(updateDateTime, 1000);

    // Sales Chart
    const ctx = document.getElementById('salesChart').getContext('2d');
    const salesData = @Html.Raw(Json.Serialize(Model.SalesChart.Values));
    const labels = @Html.Raw(Json.Serialize(Model.SalesChart.Labels));

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Daily Sales (R)',
                data: salesData,
                backgroundColor: 'rgba(34, 197, 94, 0.5)',
                borderColor: '#22c55e',
                borderWidth: 2,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return 'R ' + value.toFixed(2);
                        }
                    }
                }
            }
        }
    });

    // Payment Chart
    const paymentCtx = document.getElementById('paymentChart').getContext('2d');
    const paymentData = @Html.Raw(Json.Serialize(Model.SalesByPaymentMethod));
    const paymentLabels = Object.keys(paymentData);
    const paymentValues = Object.values(paymentData);

    const colors = {
        'Cash': '#22c55e',
        'Card': '#3b82f6',
        'Mobile': '#f59e0b',
        'Credit': '#8b5cf6'
    };

    const backgroundColors = paymentLabels.map(label => colors[label] || '#94a3b8');

    new Chart(paymentCtx, {
        type: 'doughnut',
        data: {
            labels: paymentLabels,
            datasets: [{
                data: paymentValues,
                backgroundColor: backgroundColors,
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
</script>